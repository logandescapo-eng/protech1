# Production environment — copy to .env on server (never commit .env)
DB_NAME=protech_db
DB_USER=postgres
DB_PASS=CHANGE_ME_STRONG_PASSWORD
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/1
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
